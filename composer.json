{
    "name": "beziworld/laravel-emaillabs",
    "description": "Laravel integration for EmailLabs (Vercom): mail transport, templates, tags and headers, signed delivery webhooks with events, blacklist, statistics and multiple accounts.",
    "keywords": [
        "laravel",
        "emaillabs",
        "vercom",
        "mail",
        "transport",
        "symfony-mailer",
        "webhooks",
        "transactional-email"
    ],
    "homepage": "https://github.com/beziworld/laravel-emaillabs",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Kamil Ćwiertnia",
            "email": "biuro@beziworld.eu",
            "homepage": "https://beziworld.eu",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/beziworld/laravel-emaillabs/issues",
        "source": "https://github.com/beziworld/laravel-emaillabs"
    },
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.8",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/events": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/mail": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "symfony/mailer": "^7.2|^8.0",
        "symfony/mime": "^7.2|^8.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.7|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "phpstan/phpstan-strict-rules": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Beziworld\\EmailLabs\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Beziworld\\EmailLabs\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "test-coverage": "pest --coverage --min=80",
        "analyse": "phpstan analyse --memory-limit=1G",
        "format": "pint",
        "lint": "pint --test",
        "ci": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Beziworld\\EmailLabs\\EmailLabsServiceProvider"
            ],
            "aliases": {
                "EmailLabs": "Beziworld\\EmailLabs\\Facades\\EmailLabs"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
